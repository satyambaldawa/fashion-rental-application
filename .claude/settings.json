{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard.py"
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Grep(**/.env)",
      "Grep(**/.env.*)",
      "Read(**/*key.json)",
      "Read(**/*service-account*)",
      "Edit(**/*key.json)",
      "Edit(**/*service-account*)",
      "Grep(**/*key.json)",
      "Grep(**/*service-account*)"
    ]
  }
}
