{
  "permissions": {
    "allow": [
      "Bash(podman machine list)",
      "Bash(podman ps*)",
      "Bash(podman exec fashion-rental-application-postgres-1 pg_isready -U postgres)",
      "Bash(podman exec fashion-rental-application-postgres-1 psql -U postgres -d fashionrental -tAc \"select count(*) from items\")",
      "Bash(curl -s -o /dev/null -w \"%{http_code}\" http://localhost:8080/actuator/health)",
      "Bash(curl -s -o /dev/null -w \"%{http_code}\" http://localhost:5173)",
      "Bash(until curl -sf http://localhost:8080/actuator/health >/dev/null 2>&1; do sleep 1; done; echo \"backend healthy\")",
      "Bash(until curl -sf http://localhost:5173 >/dev/null 2>&1; do sleep 1; done; echo \"frontend healthy\")",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git rev-parse:*)",
      "Bash(./gradlew build:*)",
      "Bash(./gradlew test:*)",
      "Bash(./gradlew compileJava:*)",
      "Bash(./gradlew clean:*)",
      "Bash(./gradlew bootRun --args='--spring.profiles.active=dev')",
      "Bash(pnpm test:*)",
      "Bash(pnpm build:*)",
      "Bash(pnpm type-check:*)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm dev:*)",
      "Bash(pnpm exec:*)",
      "Bash(npx vitest:*)",
      "Bash(mkdir -p:*)",
      "Bash(mv:*)",
      "Bash(cp:*)",
      "Bash(pg_isready -h localhost -p 5433)",
      "Bash(nc -z localhost 5433)",
      "Bash(lsof -ti:*)",
      "Edit(backend/**)",
      "Write(backend/**)",
      "Edit(frontend/**)",
      "Write(frontend/**)",
      "mcp__plugin_playwright_playwright__browser_navigate",
      "mcp__plugin_playwright_playwright__browser_snapshot",
      "mcp__plugin_playwright_playwright__browser_find",
      "mcp__plugin_playwright_playwright__browser_close",
      "mcp__plugin_playwright_playwright__browser_fill_form",
      "mcp__plugin_playwright_playwright__browser_click"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Grep(**/.env)",
      "Grep(**/.env.*)",
      "Read(**/*key.json)",
      "Read(**/*service-account*)",
      "Edit(**/*key.json)",
      "Edit(**/*service-account*)",
      "Grep(**/*key.json)",
      "Grep(**/*service-account*)",
      "Edit(**/.claude/worktrees/pr-*/**)",
      "Write(**/.claude/worktrees/pr-*/**)",
      "NotebookEdit(**/.claude/worktrees/pr-*/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/guard.py"
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/guard.py"
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/guard.py"
          }
        ]
      },
      {
        "matcher": "NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/guard.py"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "supabase@claude-plugins-official": true
  }
}
